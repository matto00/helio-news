# helio-news daily run — SYSTEM service (not a user unit).
# Install to: /etc/systemd/system/news.service
#
# It must be a system unit because its timer uses WakeSystem=true, and only the
# system manager may program an RTC wake alarm. It still runs the job as `matt`
# so it uses the user's venv, .env, and ~/.ollama models.
[Unit]
Description=helio-news daily aggregation → helio dashboard
Documentation=file:///home/matt/Development/helio-news/README.md
# The gemma passes need ollama on :11434. Requires= so we don't wake up and
# fail silently if ollama is down.
Requires=ollama.service
After=ollama.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=matt
Group=matt
WorkingDirectory=/home/matt/Development/helio-news
# HELIO_PAT + HELIO_API_BASE_URL (gitignored, chmod 600).
EnvironmentFile=/home/matt/Development/helio-news/.env
# Belt-and-braces: wait (up to ~60s) for ollama to answer before the run.
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do curl -sf -o /dev/null http://localhost:11434/api/tags && exit 0; sleep 2; done; echo "ollama not responding on :11434"; exit 1'
ExecStart=/home/matt/Development/helio-news/.venv/bin/python -m news.run
# `+` = run as root so it can suspend without polkit. Only re-suspends if the
# machine woke up for this run; no-ops if you're using it.
ExecStopPost=+/home/matt/Development/helio-news/deploy/suspend-if-woken.sh
# 45 min. The run measured 22.7 min on 2026-08-28 (10 stories, ~84s of model
# time each) and the old 1800s ceiling left only ~7 min of slack. The margin
# is deliberately generous so that a timeout MEANS something: at 2700s, a run
# that still overruns is not a heavy news day, it is a run that spent a very
# large amount of time blocked — almost certainly waiting out helio 429s in
# helio-mcp's retry (see HEL-495; the live budget is 120 req/60s). Check the
# `429 rate limited ... retrying` lines in `journalctl -u news.service` first.
TimeoutStartSec=2700
